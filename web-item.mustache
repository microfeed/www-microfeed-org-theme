<main id="main-content" class="item-shell">
  {{#items.0}}
  <article>
    <h1>{{title}}</h1>
    <div class="item-meta">
      <time datetime="{{date_published}}">{{_microfeed.date_published_short}}</time>
      {{#authors}} · {{name}}{{/authors}}
    </div>

    <div class="item-media">
      {{#_microfeed.is_audio}}
      {{#attachments}}
      <audio controls preload="metadata">
        <source src="{{url}}" type="{{mime_type}}" />
        Your browser does not support the audio element.
      </audio>
      {{/attachments}}
      {{/_microfeed.is_audio}}

      {{#_microfeed.is_video}}
      {{#attachments}}
      <video controls preload="metadata">
        <source src="{{url}}" type="{{mime_type}}" />
        Your browser does not support the video element.
      </video>
      {{/attachments}}
      {{/_microfeed.is_video}}

      {{#_microfeed.is_document}}
      {{#attachments}}<a class="button-secondary" href="{{url}}" target="_blank" rel="noopener nofollow">Download file →</a>{{/attachments}}
      {{/_microfeed.is_document}}

      {{#_microfeed.is_external_url}}
      <a class="button-secondary" href="{{external_url}}" target="_blank" rel="noopener nofollow">Visit source →</a>
      {{/_microfeed.is_external_url}}

      {{#_microfeed.is_image}}
      {{#attachments}}<a href="{{url}}" target="_blank" rel="noopener"><img src="{{url}}" alt="" /></a>{{/attachments}}
      {{/_microfeed.is_image}}
    </div>

    {{#image}}<p><a href="{{image}}" target="_blank" rel="noopener"><img src="{{image}}" alt="" loading="lazy" /></a></p>{{/image}}
    {{#content_html}}<div class="item-content">{{{content_html}}}</div>{{/content_html}}
    {{^content_html}}<div class="item-content"><p>{{content_text}}</p></div>{{/content_html}}
  </article>
  {{/items.0}}
</main>
